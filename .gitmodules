[submodule "submodules/mlx"]
	path = Source/Cmlx/mlx
	# atlas-open-sources/mlx = ml-explore/mlx @ ce45c525 (what 0.31.6 vendors)
	# plus the three-line RoPE batch-grid backport of 76a977ca. Return this to
